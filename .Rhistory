FP <- conf_mat["Diabetes", "No Diabetes"]
FN <- conf_mat["No Diabetes", "Diabetes"]
sensitivity <- TP / (TP + FN)
specificity <- TN / (TN + FP)
accuracy    <- (TP + TN) / sum(conf_mat)
sensitivity
specificity
accuracy
#plot roc curve with chosen threshold marked
plot(roc_obj, col = "#1a6faf", lwd = 2,
xlab = "1 - Specificity", ylab = "Sensitivity")
abline(a = 1, b = -1, lty = 2, col = "grey50")
points(1 - best_row$specificity, best_row$sensitivity,
pch = 19, col = "black", cex = 1.2)
#auc = 0.844, model has good discriminative ability
#threshold chosen to achieve ~90% sensitivity: 0.196
#clinical rationale: false negatives (missed diabetes cases) more costly than false positives
#at threshold 0.196: sensitivity = 0.899, specificity = 0.560, accuracy = 0.678
#confusion matrix: 280 TN, 241 TP, 220 FP, 27 FN
#decision rule: recommend prevention plan if predicted probability >= 0.196
