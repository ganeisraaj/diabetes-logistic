#odds ratios and 95% confidence intervals
exp(coef(model_step))
exp(confint(model_step))
#results table: coefficients, odds ratios, CIs, p-values
results <- data.frame(
Coefficient = coef(model_step),
OR          = exp(coef(model_step)),
CI_lower    = exp(confint(model_step))[, 1],
CI_upper    = exp(confint(model_step))[, 2],
p_value     = summary(model_step)$coefficients[, 4]
)
round(results, 3)
#bloodpressure and age dropped by stepwise selection; final model has 4 predictors
#pregnancies: OR = 1.154 (95% CI: 1.094-1.219, p < 0.001); each additional pregnancy increases odds by 15.4%
#glucose: OR = 1.038 (95% CI: 1.031-1.045, p < 0.001); each mg/dl increases odds by 3.8%
#bmi: OR = 1.093 (95% CI: 1.062-1.126, p < 0.001); each unit increase multiplies odds by 9.3%
#diabetespedigreefunction: OR = 2.415 (95% CI: 1.362-4.328, p = 0.003); largest OR among predictors
#all four retained predictors significant at alpha = 0.05
#final model AIC = 726.37 vs full model AIC = 727.96; parsimonious improvement
#null deviance 993.48 reduced to residual deviance 716.37; model explains substantial variation
##TASK 6
library(pROC)
#predicted probabilities from final model
diabetes_model$pred_prob <- predict(model_step, type = "response")
#roc curve
roc_obj <- roc(diabetes_model$Outcome, diabetes_model$pred_prob,
levels = c("No Diabetes", "Diabetes"))
#auc
auc(roc_obj)
#get all coords and find threshold closest to 90% sensitivity
all_coords <- coords(roc_obj, "all",
ret = c("threshold", "sensitivity", "specificity"))
best_row <- all_coords[which.min(abs(all_coords$sensitivity - 0.90)), ]
best_row
#extract threshold
threshold <- best_row$threshold
#apply threshold to classify
diabetes_model$pred_class <- ifelse(diabetes_model$pred_prob >= threshold,
"Diabetes", "No Diabetes")
diabetes_model$pred_class <- factor(diabetes_model$pred_class,
levels = c("No Diabetes", "Diabetes"))
#confusion matrix
conf_mat <- table(Predicted = diabetes_model$pred_class,
Actual    = diabetes_model$Outcome)
conf_mat
#sensitivity, specificity, accuracy at chosen threshold
TP <- conf_mat["Diabetes", "Diabetes"]
TN <- conf_mat["No Diabetes", "No Diabetes"]
FP <- conf_mat["Diabetes", "No Diabetes"]
FN <- conf_mat["No Diabetes", "Diabetes"]
sensitivity <- TP / (TP + FN)
specificity <- TN / (TN + FP)
accuracy    <- (TP + TN) / sum(conf_mat)
sensitivity
specificity
accuracy
#plot roc curve with chosen threshold marked
plot(roc_obj, col = "#1a6faf", lwd = 2,
xlab = "1 - Specificity", ylab = "Sensitivity")
abline(a = 1, b = -1, lty = 2, col = "grey50")
points(1 - best_row$specificity, best_row$sensitivity,
pch = 19, col = "black", cex = 1.2)
#auc = 0.844; model has good discriminative ability
#threshold chosen to achieve ~90% sensitivity: 0.196
#clinical rationale: false negatives (missed diabetes cases) more costly than false positives
#at threshold 0.196: sensitivity = 0.899, specificity = 0.560, accuracy = 0.678
#confusion matrix: 280 TN, 241 TP, 220 FP, 27 FN
#decision rule: recommend prevention plan if predicted probability >= 0.196
#27 true diabetes cases missed (FN); 220 non-diabetic flagged unnecessarily (FP)
##TASK 7
library(ResourceSelection)
#hosmer-lemeshow goodness of fit test
#h0: model fits the data well
#h1: model does not fit the data well
hl_test <- hoslem.test(as.numeric(diabetes_model$Outcome) - 1,
diabetes_model$pred_prob,
g = 10)
hl_test
#deviance residuals
plot(fitted(model_step), residuals(model_step, type = "deviance"),
xlab = "Fitted Values", ylab = "Deviance Residuals",
pch = 16, cex = 0.6, col = "#1a6faf")
abline(h = 0, lty = 2, col = "grey50")
#pearson residuals
plot(fitted(model_step), residuals(model_step, type = "pearson"),
xlab = "Fitted Values", ylab = "Pearson Residuals",
pch = 16, cex = 0.6, col = "#1a6faf")
abline(h = 0, lty = 2, col = "grey50")
#cooks distance: identify influential observations
plot(cooks.distance(model_step),
type = "h", ylab = "Cook's Distance",
col = "#C0392B")
abline(h = 4 / nrow(diabetes_model), lty = 2, col = "grey50")
#identify influential observations above threshold
influential <- which(cooks.distance(model_step) > 4 / nrow(diabetes_model))
length(influential)
#hosmer-lemeshow: X-squared = 11.519, df = 8, p = 0.174
#p > 0.05; h0 not rejected; model fits the data adequately
#deviance and pearson residuals show no systematic pattern around 0
#44 observations flagged as influential by cooks distance (threshold 4/768 = 0.0052)
#influential observations are present but not unexpected for a dataset of this size
#limitations: skinthickness and insulin excluded due to high missingness; predictive information lost
#age showed non-linearity in task 2; linear logistic model may not fully capture this
#dataset consists exclusively of pima indian women aged 21+; external validity is limited
#results should not be generalised to other populations, men, or younger women
##GANEISRAAJ KATHIRAVAN
##THEMA 4
##TASK 1
library(tidyverse)
#read data
diabetes <- read.csv("diabetes.csv")
#inspect
str(diabetes)
summary(diabetes)
#identify physiologically impossible zeros
#pregnancies can legitimately be 0; DiabetesPedigreeFunction and Age
#cannot be 0 but no zeros present in data
zero_counts <- sapply(
diabetes[, c("Glucose", "BloodPressure", "BMI", "SkinThickness", "Insulin")],
function(x) sum(x == 0)
)
zero_counts
#recode zeros as NA for affected variables
diabetes_clean <- diabetes %>%
mutate(
Glucose       = ifelse(Glucose == 0, NA, Glucose),
BloodPressure = ifelse(BloodPressure == 0, NA, BloodPressure),
BMI           = ifelse(BMI == 0, NA, BMI),
SkinThickness = ifelse(SkinThickness == 0, NA, SkinThickness),
Insulin       = ifelse(Insulin == 0, NA, Insulin)
)
#missingness summary
colSums(is.na(diabetes_clean))
#skinthickness (227, 29.6%) and insulin (374, 48.7%) excluded from modelling
#glucose (5, 0.7%), bloodpressure (35, 4.6%), bmi (11, 1.4%) imputed with median
#missingness below 5% for these three; median imputation introduces negligible bias
diabetes_model <- diabetes_clean %>%
dplyr::select(-SkinThickness, -Insulin) %>%
mutate(
Glucose       = ifelse(is.na(Glucose), median(Glucose, na.rm = TRUE), Glucose),
BloodPressure = ifelse(is.na(BloodPressure), median(BloodPressure, na.rm = TRUE), BloodPressure),
BMI           = ifelse(is.na(BMI), median(BMI, na.rm = TRUE), BMI)
)
nrow(diabetes_model)
#convert Outcome to factor
diabetes_clean$Outcome <- factor(diabetes_clean$Outcome,
levels = c(0, 1),
labels = c("No Diabetes", "Diabetes"))
diabetes_model$Outcome <- factor(diabetes_model$Outcome,
levels = c(0, 1),
labels = c("No Diabetes", "Diabetes"))
#distribution of Outcome
table(diabetes_clean$Outcome)
prop.table(table(diabetes_clean$Outcome))
#bar chart: distribution of Outcome
ggplot(diabetes_clean, aes(x = Outcome, fill = Outcome)) +
geom_bar() +
geom_text(stat = "count", aes(label = after_stat(count)), vjust = -0.5) +
scale_fill_manual(values = c("#1a6faf", "#C0392B")) +
labs(x = "Diagnosis", y = "Count") +
theme_bw() +
theme(legend.position = "none")
#kde plots: all variables by Outcome
diabetes_clean %>%
pivot_longer(cols = -Outcome,
names_to = "Variable",
values_to = "Value") %>%
drop_na() %>%
ggplot(aes(x = Value, fill = Outcome)) +
geom_density(alpha = 0.4) +
facet_wrap(~ Variable, scales = "free") +
scale_fill_manual(values = c("#1a6faf", "#C0392B")) +
labs(x = NULL, y = "Density", fill = "Diagnosis") +
theme_bw() +
theme(legend.position = "bottom")
#500 of 768 observations have no diabetes (65.1%), 268 have diabetes (34.9%)
#glucose, bmi, and age show the clearest separation between groups
#insulin (374, 48.7%) and skinthickness (227, 29.6%) excluded from modelling
#glucose, bloodpressure, bmi imputed with median due to low missingness (<5%)
#all 768 observations retained in diabetes_model
##TASK 2
library(psych)
library(GGally)
#loess scatterplots: each predictor vs Outcome to assess relationship type
diabetes_model %>%
pivot_longer(cols = -Outcome,
names_to = "Variable",
values_to = "Value") %>%
ggplot(aes(x = Value, y = as.numeric(Outcome) - 1, color = Outcome)) +
geom_jitter(height = 0.05, alpha = 0.3, size = 0.8) +
geom_smooth(method = "loess", se = FALSE, color = "black", linewidth = 0.7) +
facet_wrap(~ Variable, scales = "free_x") +
scale_color_manual(values = c("#1a6faf", "#C0392B")) +
labs(x = NULL, y = "Outcome (0/1)", color = "Diagnosis") +
guides(color = guide_legend(override.aes = list(alpha = 1, size = 3))) +
theme_bw(base_size = 10) +
theme(legend.position = "bottom")
#ggpairs: pairwise relationships coloured by Outcome, Outcome excluded as column
#diagonal uses boxplots by outcome group instead of kde to avoid redundancy with figure 1
ggpairs(diabetes_model %>% dplyr::select(-Outcome),
mapping = aes(color = diabetes_model$Outcome, alpha = 0.4),
upper = list(continuous = wrap("cor", size = 3)),
lower = list(continuous = wrap("points", size = 0.5, shape = 16)),
diag  = list(continuous = wrap("box_no_facet"))) +
scale_color_manual(values = c("#1a6faf", "#C0392B")) +
scale_fill_manual(values = c("#1a6faf", "#C0392B")) +
theme_bw(base_size = 8)
#descriptive statistics by Outcome group
describeBy(diabetes_model %>% dplyr::select(-Outcome),
group = diabetes_model$Outcome)
#glucose shows the clearest monotone positive relationship with diabetes risk
#bmi and age also show clear positive associations
#pregnancies and diabetespedigreefunction show moderate positive monotone relationships
#age shows slight non-linearity; risk increases steeply up to ~40 then flattens
#bloodpressure shows weak association
##TASK 3
#check complete separation for each predictor individually
#density plots per predictor coloured by Outcome to visually assess overlap
diabetes_model %>%
pivot_longer(cols = -Outcome,
names_to = "Variable",
values_to = "Value") %>%
ggplot(aes(x = Value, fill = Outcome)) +
geom_density(alpha = 0.4) +
facet_wrap(~ Variable, scales = "free") +
scale_fill_manual(values = c("#1a6faf", "#C0392B")) +
labs(x = NULL, y = "Density", fill = "Diagnosis") +
theme_bw(base_size = 10) +
theme(legend.position = "bottom")
#value ranges per predictor by Outcome group
aggregate(. ~ Outcome, data = diabetes_model, FUN = range)
#check overlap: if ranges do not overlap, complete separation exists
tapply(diabetes_model$Glucose, diabetes_model$Outcome, range)
tapply(diabetes_model$BMI, diabetes_model$Outcome, range)
tapply(diabetes_model$Age, diabetes_model$Outcome, range)
tapply(diabetes_model$BloodPressure, diabetes_model$Outcome, range)
tapply(diabetes_model$Pregnancies, diabetes_model$Outcome, range)
tapply(diabetes_model$DiabetesPedigreeFunction, diabetes_model$Outcome, range)
#joint separation check across all predictor combinations using detectseparation
#per-predictor range overlap is not sufficient on its own; separation can in
#principle arise from a linear combination of predictors even when no single
#predictor separates the outcome
library(detectseparation)
install.packages("detectseparation")
#joint separation check across all predictor combinations using detectseparation
#per-predictor range overlap is not sufficient on its own; separation can in
#principle arise from a linear combination of predictors even when no single
#predictor separates the outcome
install.packages("detectseparation")
library(detectseparation)
separation_check <- glm(Outcome ~ Pregnancies + Glucose + BloodPressure + BMI +
DiabetesPedigreeFunction + Age,
data = diabetes_model,
family = binomial("logit"),
method = "detect_separation")
separation_check
